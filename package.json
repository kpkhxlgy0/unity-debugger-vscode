{
  "name": "unity-debugger-pure",
  "displayName": "Unity Debugger Pure",
  "icon": "images/icon.png",
  "description": "Pure managed C# debugging for local Unity 2022 and Tuanjie Editors, without C# Dev Kit or Microsoft's Unity extension.",
  "publisher": "kpk",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpkhxlgy0/unity-debugger-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/kpkhxlgy0/unity-debugger-vscode/issues"
  },
  "homepage": "https://github.com/kpkhxlgy0/unity-debugger-vscode#readme",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=26.5.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "os": [
    "win32"
  ],
  "categories": [
    "Debuggers"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onDebugResolve:unity-debugger-pure",
    "onCommand:unity-debugger-pure.refreshTargets",
    "onCommand:unity-debugger-pure.openLogs",
    "onCommand:unity-debugger-pure.copyDiagnostics"
  ],
  "contributes": {
    "commands": [
      {
        "command": "unity-debugger-pure.refreshTargets",
        "title": "Unity Debugger Pure: Refresh Local Editors"
      },
      {
        "command": "unity-debugger-pure.openLogs",
        "title": "Unity Debugger Pure: Open Sanitized Diagnostics"
      },
      {
        "command": "unity-debugger-pure.copyDiagnostics",
        "title": "Unity Debugger Pure: Copy Sanitized Diagnostics"
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      }
    ],
    "debuggers": [
      {
        "type": "unity-debugger-pure",
        "label": "Unity Debugger Pure",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "name",
              "type",
              "request"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "unity-debugger-pure"
                ]
              },
              "request": {
                "enum": [
                  "attach"
                ]
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Attach to Unity Debugger Pure",
            "body": {
              "name": "Attach to Unity Debugger Pure",
              "type": "unity-debugger-pure",
              "request": "attach"
            }
          }
        ],
        "initialConfigurations": [
          {
            "name": "Attach to Unity Debugger Pure",
            "type": "unity-debugger-pure",
            "request": "attach"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build:extension": "node esbuild.mjs",
    "build:adapter": "dotnet restore UnityDebugger.sln --locked-mode && dotnet build UnityDebugger.sln -c Release --no-restore",
    "build": "npm run build:extension && npm run build:adapter",
    "typecheck": "tsc -p tsconfig.json",
    "verify:third-party": "node scripts/verify-third-party.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:extension": "vitest run tests/extension",
    "test:adapter": "dotnet test UnityDebugger.sln -c Release --no-restore",
    "test:integration": "vitest run tests/integration",
    "test:package": "node --test tests/package/vsix.test.mjs",
    "test": "npm run test:build && npm run test:extension && npm run test:adapter && npm run test:integration",
    "stage:adapter": "node scripts/stage-adapter.mjs",
    "inventory:runtime:write": "node scripts/generate-runtime-inventory.mjs --write",
    "inventory:runtime": "node scripts/generate-runtime-inventory.mjs --verify",
    "verify:vsix": "node scripts/verify-vsix.mjs dist/unity-debugger-pure-0.3.0.vsix",
    "verify:release-artifact": "node scripts/verify-release-artifact.mjs dist/unity-debugger-pure-0.3.0.vsix dist/unity-debugger-pure-0.3.0.vsix.sha256 v0.3.0",
    "package": "npm run build && npm run stage:adapter && npm run inventory:runtime && vsce package --out dist/unity-debugger-pure-0.3.0.vsix && npm run verify:vsix && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.9.2",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "ovsx": "1.0.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
